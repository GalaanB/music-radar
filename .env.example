# Token du bot : à créer via @BotFather sur Telegram (/newbot)
TELEGRAM_BOT_TOKEN=123456:ABC-remplace-moi

# Ton chat ID : écris un message à ton bot, puis ouvre
# https://api.telegram.org/bot<TOKEN>/getUpdates et relève "chat": {"id": ...}
TELEGRAM_CHAT_ID=123456789

# Heure de lancement du scan (fuseau Europe/Paris). Il dure ~20 min :
# 07:10 -> message reçu vers 07:30.
DAILY_TIME=07:10
WEEKLY_TIME=07:10

# 1 = envoyer aussi un message "rien de nouveau" les jours sans sortie
SEND_EMPTY_DAILY=0

# Jours couverts par le récap quotidien (rattrape les sorties qu'Apple affiche en retard)
DAILY_LOOKBACK_DAYS=14

# Featurings sur l'album d'un autre artiste (1 recherche de plus par artiste, scan ~20 min) : 1 | 0
FEATURES=1
# Featurings trouvés via MusicBrainz (0 = recherche par nom chez Apple seulement) : 1 | 0
MUSICBRAINZ=1

# Pays du catalogue Apple Music
ITUNES_COUNTRY=fr

# --- Réglages optionnels (valeurs par défaut) ---
# Nombre max de sorties envoyées sous forme de cartes à boutons ; au-delà : liste + /trier
CARDS_MAX=12
# Pochette en miniature : small | off
COVERS=small
# Analyse "déjà sorti en single / réédition" (1 appel iTunes de plus par album) : 1 | 0
NOVELTY=1
# Sorties à venir annoncées le vendredi : nombre de jours et nombre de lignes max
UPCOMING_DAYS=7
UPCOMING_MAX=8
